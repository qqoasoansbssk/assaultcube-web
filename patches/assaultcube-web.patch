+#ifdef __EMSCRIPTEN__
+// The page cannot wait on a socket (the reply is delivered by the same thread that would be
+// waiting), so the list comes from the local server's /master endpoint (web/serve.mjs) via a
+// synchronous HTTP request. Returns a malloc'ed string (or NULL).
+EM_JS(char *, web_fetchmasterlist, (const char *name, int version, int build), {
+    try {
+        var xhr = new XMLHttpRequest();
+        xhr.open('GET', '/master?name=' + encodeURIComponent(UTF8ToString(name)) + '&version=' + version + '&build=' + build, false);
+        xhr.send();
+        if (xhr.status !== 200) return 0;
+        return stringToNewUTF8(xhr.responseText);
+    } catch (e) { console.warn('server list request failed', e); return 0; }
+});
+#endif
+
