+// WebGL cannot read the depth buffer, so the point under the crosshair is found by marching
+// along the view ray through the cube map until it enters a solid cube, floor or ceiling.
+static bool web_raycast(const vec &from, const vec &to, vec &hit)
+{
+    vec dir = to;
+    dir.sub(from);
+    float len = dir.magnitude();
+    if(len < 1e-4f) return false;
+    const float stepsize = 0.05f;
+    dir.mul(stepsize / len);
+    int steps = int(min(len, 2048.0f) / stepsize);
+    vec p = from;
+    loopi(steps)
+    {
+        p.add(dir);
+        int x = int(floorf(p.x)), y = int(floorf(p.y));
+        if(OUTBORD(x, y)) return false;
+        sqr *s = S(x, y);
+        if(SOLID(s) || p.z < s->floor || p.z > s->ceil) { hit = p; return true; }
+    }
+    return false;
+}
+#endif
